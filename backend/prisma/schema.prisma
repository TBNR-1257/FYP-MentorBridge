generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// =========================================================
// Enums
// =========================================================

enum Role {
  STUDENT
  MENTOR
  ADMIN
}

enum DifficultyLevel {
  BEGINNER
  INTERMEDIATE
  EXPERT
}

enum CourseStatus {
  ACTIVE
  ARCHIVED
}

enum SubjectRequestStatus {
  PENDING
  APPROVED
  REJECTED
}

enum VerificationStatus {
  PENDING
  VERIFIED
  REJECTED
}

enum UrgencyLevel {
  LOW
  MEDIUM
  HIGH
}

enum HelpRequestStatus {
  OPEN
  REQUESTED
  MATCHED
  IN_PROGRESS
  COMPLETED
  CANCELLED
}

enum SessionStatus {
  SCHEDULED
  COMPLETED
  NO_SHOW
  CANCELLED
}

enum BadgeMetric {
  RATING_COUNT
  SERVICE_HOURS
  SESSION_COUNT
}

// =========================================================
// Users & Profiles
// =========================================================

model User {
  id           String @id @default(uuid())
  email        String @unique
  passwordHash String
  role         Role
  name         String

  isActive        Boolean   @default(true)
  suspendedAt     DateTime?
  suspendedReason String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  studentProfile StudentProfile?
  mentorProfile  MentorProfile?

  sentNotifications Notification[]  @relation("NotificationUser")
  endorsementsGiven Endorsement[]   @relation("EndorsementEndorser")
  uploadedResources Resource[]
  ratingsGiven      Rating[]        @relation("RatingRater")
  ratingsReceived   Rating[]        @relation("RatingRatee")
  chatMessages      ChatMessage[]
  courseChatMessages CourseChatMessage[]
  verifiedMentors   MentorProfile[] @relation("MentorVerifiedBy")
  subjectRequests         SubjectRequest[] @relation("SubjectRequestRequestedBy")
  reviewedSubjectRequests SubjectRequest[] @relation("SubjectRequestReviewedBy")
}

// Deliberately minimal: subject, education level, and language preference are
// specified per help request rather than fixed on the profile, since a student
// may need help in different subjects/levels/languages on different occasions.
model StudentProfile {
  id     String @id @default(uuid())
  userId String @unique
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  helpRequests HelpRequest[]
  interests       StudentInterest[]
  enrolledCourses CourseEnrollment[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model MentorProfile {
  id     String @id @default(uuid())
  userId String @unique
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  qualifications String
  languages      String[]
  bio            String?

  verificationStatus VerificationStatus @default(PENDING)
  verifiedAt         DateTime?
  verifiedByAdminId  String?
  verifiedByAdmin    User?              @relation("MentorVerifiedBy", fields: [verifiedByAdminId], references: [id])

  subjects              MentorSubject[]
  availability          Availability[]
  sessions              Session[]
  matchSuggestions      MatchSuggestion[]
  serviceHourLogs       ServiceHourLog[]
  badges                MentorBadge[]
  endorsements          Endorsement[]
  requestedHelpRequests HelpRequest[]     @relation("HelpRequestRequestedMentor")
  courses               Course[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([verificationStatus])
}

// =========================================================
// Subjects (shared taxonomy for matching & analytics)
// =========================================================

model Subject {
  id   String @id @default(uuid())
  name String @unique

  mentors      MentorSubject[]
  helpRequests HelpRequest[]
  endorsements Endorsement[]
  courses      Course[]
  interests    StudentInterest[]
}

model MentorSubject {
  mentorProfileId String
  mentorProfile   MentorProfile @relation(fields: [mentorProfileId], references: [id], onDelete: Cascade)
  subjectId       String
  subject         Subject       @relation(fields: [subjectId], references: [id], onDelete: Cascade)

  @@id([mentorProfileId, subjectId])
}

// Recurring weekly availability, e.g. dayOfWeek=1 (Monday) 14:00-16:00
model Availability {
  id              String        @id @default(uuid())
  mentorProfileId String
  mentorProfile   MentorProfile @relation(fields: [mentorProfileId], references: [id], onDelete: Cascade)

  dayOfWeek Int // 0 = Sunday ... 6 = Saturday
  startTime String // "HH:mm"
  endTime   String // "HH:mm"

  @@index([mentorProfileId])
}

// =========================================================
// Help Requests & Matching
// =========================================================

model HelpRequest {
  id               String         @id @default(uuid())
  studentProfileId String
  studentProfile   StudentProfile @relation(fields: [studentProfileId], references: [id], onDelete: Cascade)

  subjectId String
  subject   Subject @relation(fields: [subjectId], references: [id])

  topic        String
  description  String?
  urgencyLevel UrgencyLevel
  status       HelpRequestStatus @default(OPEN)

  // Set when a student requests a specific mentor from their ranked suggestions;
  // only that mentor can act on the request until they accept or decline it.
  requestedMentorProfileId String?
  requestedMentorProfile   MentorProfile? @relation("HelpRequestRequestedMentor", fields: [requestedMentorProfileId], references: [id])

  // Specified per request rather than fixed on StudentProfile.
  difficultyLevel     DifficultyLevel
  languagePreferences String[]

  // Preferred slot for the session, matched against MentorProfile.availability
  // by the rule-based matching algorithm.
  preferredDayOfWeek Int // 0 = Sunday ... 6 = Saturday
  preferredStartTime String // "HH:mm"
  preferredEndTime   String // "HH:mm"

  matchSuggestions MatchSuggestion[]
  sessions         Session[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status])
  @@index([subjectId])
}

// Ranked mentor suggestions produced by the rule-based matching algorithm
// (subject, availability, language) for a given help request.
model MatchSuggestion {
  id              String        @id @default(uuid())
  helpRequestId   String
  helpRequest     HelpRequest   @relation(fields: [helpRequestId], references: [id], onDelete: Cascade)
  mentorProfileId String
  mentorProfile   MentorProfile @relation(fields: [mentorProfileId], references: [id], onDelete: Cascade)

  score Float
  rank  Int

  createdAt DateTime @default(now())

  @@unique([helpRequestId, mentorProfileId])
}

// =========================================================
// Sessions
// =========================================================

model Session {
  id              String        @id @default(uuid())
  helpRequestId   String
  helpRequest     HelpRequest   @relation(fields: [helpRequestId], references: [id], onDelete: Cascade)
  mentorProfileId String
  mentorProfile   MentorProfile @relation(fields: [mentorProfileId], references: [id])

  status SessionStatus @default(SCHEDULED)

  scheduledAt DateTime
  startedAt   DateTime?
  endedAt     DateTime?

  confidenceBefore Int? // 1-5 self-rated confidence, logged before the session
  confidenceAfter  Int? // 1-5 self-rated confidence, logged after the session
  mentorNotes      String?

  // Set by the mentor once a time is actually agreed (e.g. in chat) — never
  // auto-generated from scheduledAt, since that can go stale if the time shifts.
  meetingLink String?

  chatMessages   ChatMessage[]
  ratings        Rating[]
  serviceHourLog ServiceHourLog?
  resources      Resource[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status])
  @@index([mentorProfileId])
}

model ChatMessage {
  id        String  @id @default(uuid())
  sessionId String
  session   Session @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  senderId  String
  sender    User    @relation(fields: [senderId], references: [id])

  content String
  sentAt  DateTime @default(now())

  @@index([sessionId])
}

// =========================================================
// Courses (mentor-run recurring group classes)
// =========================================================

model Course {
  id              String        @id @default(uuid())
  mentorProfileId String
  mentorProfile   MentorProfile @relation(fields: [mentorProfileId], references: [id], onDelete: Cascade)

  subjectId String
  subject   Subject @relation(fields: [subjectId], references: [id])

  title           String
  description     String
  difficultyLevel DifficultyLevel
  status          CourseStatus @default(ACTIVE)

  // Set by the mentor once created — same manual Google Meet handoff pattern as
  // a 1:1 session, reused across every weekly occurrence of this course.
  meetingLink String?

  timeSlots   CourseTimeSlot[]
  enrollments CourseEnrollment[]
  sessions    CourseSession[]
  messages    CourseChatMessage[]
  resources   Resource[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([subjectId])
  @@index([mentorProfileId])
}

// Recurring weekly meeting time for a course; a course can have more than one
// (e.g. Mon and Wed sections of the same class), each running its own series
// of CourseSession occurrences.
model CourseTimeSlot {
  id       String @id @default(uuid())
  courseId String
  course   Course @relation(fields: [courseId], references: [id], onDelete: Cascade)

  dayOfWeek Int // 0 = Sunday ... 6 = Saturday
  startTime String // "HH:mm"
  endTime   String // "HH:mm"

  sessions CourseSession[]

  @@index([courseId])
}

// A student's standing membership in a course — instant self-serve join/leave,
// no mentor approval (unlike 1:1 help-request matching).
model CourseEnrollment {
  courseId         String
  course           Course         @relation(fields: [courseId], references: [id], onDelete: Cascade)
  studentProfileId String
  studentProfile   StudentProfile @relation(fields: [studentProfileId], references: [id], onDelete: Cascade)

  joinedAt DateTime @default(now())

  @@id([courseId, studentProfileId])
}

// One dated weekly occurrence of a course's class, mirroring the 1:1 Session
// lifecycle (start/complete/no-show) so course teaching counts toward service
// hours and badges. Whole-session-level only — no per-student attendance yet.
model CourseSession {
  id               String          @id @default(uuid())
  courseId         String
  course           Course          @relation(fields: [courseId], references: [id], onDelete: Cascade)
  courseTimeSlotId String?
  courseTimeSlot   CourseTimeSlot? @relation(fields: [courseTimeSlotId], references: [id], onDelete: SetNull)

  status SessionStatus @default(SCHEDULED)

  scheduledAt DateTime
  startedAt   DateTime?
  endedAt     DateTime?
  mentorNotes String?

  serviceHourLog ServiceHourLog?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status])
  @@index([courseId])
}

// Continuous group chat for a course — one ongoing thread for the whole class,
// separate from individual CourseSession occurrences.
model CourseChatMessage {
  id       String @id @default(uuid())
  courseId String
  course   Course @relation(fields: [courseId], references: [id], onDelete: Cascade)
  senderId String
  sender   User   @relation(fields: [senderId], references: [id])

  content String
  sentAt  DateTime @default(now())

  @@index([courseId])
}

// A mentor-shared link (notes, practice sheets, etc.) attached to either a 1:1
// session or a course — exactly one of sessionId/courseId is set (enforced in
// the service layer, same pattern as ServiceHourLog's dual FK). Links only, no
// file upload, to avoid needing new storage/upload-security infrastructure.
model Resource {
  id          String   @id @default(uuid())
  title       String
  description String?
  url         String

  sessionId String?
  session   Session? @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  courseId  String?
  course    Course?  @relation(fields: [courseId], references: [id], onDelete: Cascade)

  uploadedById String
  uploadedBy   User   @relation(fields: [uploadedById], references: [id])

  createdAt DateTime @default(now())

  @@index([sessionId])
  @@index([courseId])
}

// =========================================================
// Ratings & Feedback
// =========================================================

// Covers both directions: student rating a mentor after a session,
// and a mentor rating a student (including no-show / misconduct flags).
model Rating {
  id        String  @id @default(uuid())
  sessionId String
  session   Session @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  raterId String
  rater   User   @relation("RatingRater", fields: [raterId], references: [id])
  rateeId String
  ratee   User   @relation("RatingRatee", fields: [rateeId], references: [id])

  score        Int? // 1-5, optional since a flag-only mentor->student rating may carry no score
  comment      String?
  isNoShow     Boolean @default(false)
  isMisconduct Boolean @default(false)

  createdAt DateTime @default(now())

  @@unique([sessionId, raterId])
}

// =========================================================
// Gamification & Service Hours
// =========================================================

// Logged against either a 1:1 Session or a group CourseSession — exactly one of
// sessionId/courseSessionId is set (enforced in the service layer, not the DB),
// so a mentor's total hours/badge standing naturally covers both kinds of
// teaching from a single summed table.
model ServiceHourLog {
  id              String         @id @default(uuid())
  sessionId       String?        @unique
  session         Session?       @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  courseSessionId String?        @unique
  courseSession   CourseSession? @relation(fields: [courseSessionId], references: [id], onDelete: Cascade)
  mentorProfileId String
  mentorProfile   MentorProfile  @relation(fields: [mentorProfileId], references: [id], onDelete: Cascade)

  hours    Decimal  @db.Decimal(5, 2)
  loggedAt DateTime @default(now())

  @@index([mentorProfileId])
}

model Badge {
  id          String  @id @default(uuid())
  name        String  @unique
  description String
  iconUrl     String?
  criteria    String // human-readable description of how it's earned

  // Machine-checkable form of the same criteria, so awarding is automatic
  // rather than hardcoded per badge.
  metric    BadgeMetric
  threshold Int

  mentors MentorBadge[]
}

model MentorBadge {
  mentorProfileId String
  mentorProfile   MentorProfile @relation(fields: [mentorProfileId], references: [id], onDelete: Cascade)
  badgeId         String
  badge           Badge         @relation(fields: [badgeId], references: [id], onDelete: Cascade)

  earnedAt DateTime @default(now())

  @@id([mentorProfileId, badgeId])
}

// Skill endorsements given to a mentor (typically by a student after a session).
model Endorsement {
  id              String        @id @default(uuid())
  mentorProfileId String
  mentorProfile   MentorProfile @relation(fields: [mentorProfileId], references: [id], onDelete: Cascade)
  endorserId      String
  endorser        User          @relation("EndorsementEndorser", fields: [endorserId], references: [id], onDelete: Cascade)
  subjectId       String
  subject         Subject       @relation(fields: [subjectId], references: [id])

  message String?

  createdAt DateTime @default(now())

  @@unique([mentorProfileId, endorserId, subjectId])
}

// =========================================================
// Notifications (real-time, delivered over Socket.io)
// =========================================================

model Notification {
  id     String @id @default(uuid())
  userId String
  user   User   @relation("NotificationUser", fields: [userId], references: [id], onDelete: Cascade)

  type    String
  message String
  link    String?
  isRead  Boolean @default(false)

  createdAt DateTime @default(now())

  @@index([userId, isRead])
}

// =========================================================
// Student interests & subject moderation
// =========================================================

// A student's declared subjects of interest (capped at 3, enforced in the
// service layer) — drives the "recommended courses" dashboard section.
model StudentInterest {
  studentProfileId String
  studentProfile   StudentProfile @relation(fields: [studentProfileId], references: [id], onDelete: Cascade)
  subjectId        String
  subject          Subject        @relation(fields: [subjectId], references: [id], onDelete: Cascade)

  @@id([studentProfileId, subjectId])
}

// A student-submitted request for a new subject tag that doesn't exist yet —
// students can't create Subject rows directly (unlike mentors, whose profile
// already goes through admin verification); an admin reviews and approves or
// rejects each request from the admin dashboard.
model SubjectRequest {
  id            String               @id @default(uuid())
  name          String
  requestedById String
  requestedBy   User                 @relation("SubjectRequestRequestedBy", fields: [requestedById], references: [id], onDelete: Cascade)
  status        SubjectRequestStatus @default(PENDING)

  reviewedAt        DateTime?
  reviewedByAdminId String?
  reviewedByAdmin   User?     @relation("SubjectRequestReviewedBy", fields: [reviewedByAdminId], references: [id])

  createdAt DateTime @default(now())

  @@index([status])
}
